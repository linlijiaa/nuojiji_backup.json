[{"id":"cwt-1786651031208-4rnw","name":"后台","size":"small","html":"<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n      user-select: none;\n    }\n\n    body {\n      font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"PingFang SC\", \"Helvetica Neue\", sans-serif;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      background: transparent;\n      padding: 12px;\n    }\n\n    /* 2x2 卡片容器：加入菱角分明阴影 + 悬浮浮动动画 */\n    .ins-widget {\n      width: 160px;\n      height: 160px;\n      padding: 12px;\n      border-radius: 26px;\n      background: rgba(255, 255, 255, 0.85);\n      backdrop-filter: blur(20px);\n      -webkit-backdrop-filter: blur(20px);\n      border: 1.5px solid #ffffff;\n      \n      /* 菱角分明、立体感极强的硬边阴影 */\n      box-shadow: 6px 8px 0px rgba(0, 0, 0, 0.1), 0 16px 24px rgba(0, 0, 0, 0.05);\n      \n      /* 卡片上下缓缓悬浮动画 */\n      animation: float 4s ease-in-out infinite;\n      \n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: space-between;\n      color: #2c2c2e;\n      transition: box-shadow 0.3s ease;\n    }\n\n    /* 卡片悬浮动画定义 */\n    @keyframes float {\n      0%, 100% {\n        transform: translateY(0px);\n      }\n      50% {\n        transform: translateY(-6px);\n      }\n    }\n\n    /* 上半部分：大黑胶唱片（直接作为上传图片的 label） */\n    .disc-box {\n      width: 86px;\n      height: 86px;\n      border-radius: 50%;\n      background-color: #2c2c2e;\n      background-size: cover;\n      background-position: center;\n      border: 2px solid #ffffff;\n      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);\n      position: relative;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      cursor: pointer;\n      overflow: hidden;\n      flex-shrink: 0;\n      margin-top: 2px;\n      transition: transform 0.2s ease;\n    }\n\n    .disc-box:active {\n      transform: scale(0.96);\n    }\n\n    /* 唱片中心圆孔 */\n    .disc-box::after {\n      content: '';\n      position: absolute;\n      width: 14px;\n      height: 14px;\n      background: #ffffff;\n      border-radius: 50%;\n      box-shadow: 0 0 2px rgba(0, 0, 0, 0.15);\n    }\n\n    /* 播放时的旋转效果 */\n    .disc-box.playing {\n      animation: spin 9s linear infinite;\n    }\n\n    @keyframes spin {\n      100% { transform: rotate(360deg); }\n    }\n\n    /* 下半部分：歌名 + 横排按钮 + 进度条 */\n    .bottom-section {\n      width: 100%;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n\n    /* 歌名与小按钮横排组合 */\n    .info-row {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 6px;\n      width: 100%;\n    }\n\n    /* 歌名简约截断 */\n    .song-title {\n      font-size: 11px;\n      font-weight: 500;\n      color: #3a3a3c;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      flex: 1;\n    }\n\n    /* 右侧控制小按钮组 */\n    .btn-group {\n      display: flex;\n      align-items: center;\n      gap: 5px;\n      flex-shrink: 0;\n    }\n\n    /* 音乐上传极简小灰钮 */\n    .icon-btn {\n      width: 22px;\n      height: 22px;\n      border-radius: 50%;\n      background: #f0f0f2;\n      border: none;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      font-size: 10px;\n      cursor: pointer;\n      color: #636366;\n      transition: all 0.2s ease;\n    }\n\n    .icon-btn:hover {\n      background: #e5e5e8;\n      color: #1c1c1e;\n    }\n\n    .icon-btn:active {\n      transform: scale(0.92);\n    }\n\n    /* 播放/暂停低调小灰钮 */\n    .play-btn {\n      width: 24px;\n      height: 24px;\n      border-radius: 50%;\n      border: none;\n      background: #f0f0f2;\n      color: #3a3a3c;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      outline: none;\n    }\n\n    .play-btn:hover {\n      background: #e5e5e8;\n      color: #1c1c1e;\n    }\n\n    .play-btn:active {\n      transform: scale(0.92);\n    }\n\n    .play-btn svg {\n      width: 11px;\n      height: 11px;\n      fill: currentColor;\n    }\n\n    /* 极细浅灰进度条 */\n    .progress-bar {\n      width: 100%;\n      height: 3px;\n      background: rgba(0, 0, 0, 0.05);\n      border-radius: 3px;\n      cursor: pointer;\n      position: relative;\n      overflow: hidden;\n    }\n\n    .progress-fill {\n      height: 100%;\n      width: 0%;\n      background: #8e8e93;\n      border-radius: 3px;\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"ins-widget\">\n  <!-- 唱片封面（点击直接选择照片） -->\n  <label class=\"disc-box\" id=\"disc-box\" title=\"点击更换唱片封面\">\n    <input type=\"file\" id=\"cover-file\" accept=\"image/*\" hidden />\n  </label>\n\n  <!-- 底部：歌名 + 横排小按钮 + 进度条 -->\n  <div class=\"bottom-section\">\n    <div class=\"info-row\">\n      <div class=\"song-title\" id=\"song-title\">点击 🎵 上传音乐</div>\n      \n      <div class=\"btn-group\">\n        <!-- 选择本地音乐 -->\n        <label class=\"icon-btn\" title=\"选择本地音乐\">\n          🎵\n          <input type=\"file\" id=\"audio-file\" accept=\"audio/*\" hidden />\n        </label>\n\n        <!-- 播放/暂停 -->\n        <button class=\"play-btn\" id=\"play-btn\" title=\"播放/暂停\">\n          <svg id=\"play-icon\" viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg>\n          <svg id=\"pause-icon\" viewBox=\"0 0 24 24\" style=\"display:none;\"><path d=\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"/></svg>\n        </button>\n      </div>\n    </div>\n\n    <!-- 进度条 -->\n    <div class=\"progress-bar\" id=\"progress-bar\">\n      <div class=\"progress-fill\" id=\"progress\"></div>\n    </div>\n  </div>\n</div>\n\n<script>\nwidget.onReady(async () => {\n  const titleEl = document.getElementById('song-title')\n  const playBtn = document.getElementById('play-btn')\n  const playIcon = document.getElementById('play-icon')\n  const pauseIcon = document.getElementById('pause-icon')\n  const progress = document.getElementById('progress')\n  const progressBar = document.getElementById('progress-bar')\n  const audioInput = document.getElementById('audio-file')\n  const coverInput = document.getElementById('cover-file')\n  const discBox = document.getElementById('disc-box')\n\n  // 初始化 Web Audio API 独立音轨引擎\n  const AudioContext = window.AudioContext || window.webkitAudioContext\n  let audioCtx = null\n  let audioBuffer = null\n  let sourceNode = null\n\n  let isPlaying = false\n  let startTime = 0\n  let pauseOffset = 0\n  let animFrameId = null\n\n  function initAudioContext() {\n    if (!audioCtx) {\n      audioCtx = new AudioContext()\n    }\n    if (audioCtx.state === 'suspended') {\n      audioCtx.resume()\n    }\n  }\n\n  // 1. 点击唱片换图片 📷\n  coverInput.onchange = (e) => {\n    const file = e.target.files[0]\n    if (file) {\n      const reader = new FileReader()\n      reader.onload = (evt) => {\n        discBox.style.backgroundImage = `url(${evt.target.result})`\n      }\n      reader.readAsDataURL(file)\n    }\n  }\n\n  // 2. 选择本地音乐 🎵\n  audioInput.onchange = async (e) => {\n    const file = e.target.files[0]\n    if (!file) return\n\n    initAudioContext()\n    titleEl.textContent = '载入中...'\n\n    try {\n      const arrayBuffer = await file.arrayBuffer()\n      audioBuffer = await audioCtx.decodeAudioData(arrayBuffer)\n      \n      const fileName = file.name.replace(/\\.[^/.]+$/, \"\")\n      titleEl.textContent = fileName\n\n      pauseOffset = 0\n      playBuffer(0)\n    } catch (err) {\n      titleEl.textContent = '音频格式不支持'\n      console.error(err)\n    }\n  }\n\n  // 播放逻辑\n  function playBuffer(offset = 0) {\n    if (!audioBuffer) return\n    initAudioContext()\n\n    if (sourceNode) {\n      try { sourceNode.stop() } catch (e) {}\n    }\n\n    sourceNode = audioCtx.createBufferSource()\n    sourceNode.buffer = audioBuffer\n    sourceNode.loop = true\n    sourceNode.connect(audioCtx.destination)\n\n    startTime = audioCtx.currentTime - offset\n    pauseOffset = offset\n    sourceNode.start(0, offset % audioBuffer.duration)\n\n    isPlaying = true\n    updateUI(true)\n    startProgress()\n  }\n\n  // 暂停逻辑\n  function pauseBuffer() {\n    if (sourceNode && audioBuffer) {\n      pauseOffset = (audioCtx.currentTime - startTime) % audioBuffer.duration\n      try { sourceNode.stop() } catch (e) {}\n      sourceNode = null\n    }\n    isPlaying = false\n    updateUI(false)\n    stopProgress()\n  }\n\n  function togglePlay(playState) {\n    const targetState = playState !== undefined ? playState : !isPlaying\n    if (targetState) {\n      playBuffer(pauseOffset)\n    } else {\n      pauseBuffer()\n    }\n  }\n\n  // UI 状态切换\n  function updateUI(playing) {\n    if (playing) {\n      playIcon.style.display = 'none'\n      pauseIcon.style.display = 'block'\n      discBox.classList.add('playing')\n    } else {\n      playIcon.style.display = 'block'\n      pauseIcon.style.display = 'none'\n      discBox.classList.remove('playing')\n    }\n  }\n\n  // 进度条渲染\n  function startProgress() {\n    stopProgress()\n    function tick() {\n      if (isPlaying && audioBuffer) {\n        const current = (audioCtx.currentTime - startTime) % audioBuffer.duration\n        const pct = (current / audioBuffer.duration) * 100\n        progress.style.width = pct + '%'\n        animFrameId = requestAnimationFrame(tick)\n      }\n    }\n    tick()\n  }\n\n  function stopProgress() {\n    if (animFrameId) {\n      cancelAnimationFrame(animFrameId)\n      animFrameId = null\n    }\n  }\n\n  playBtn.onclick = () => togglePlay()\n\n  // 进度条点击跳转\n  progressBar.onclick = (e) => {\n    if (!audioBuffer) return\n    const rect = progressBar.getBoundingClientRect()\n    const pos = (e.clientX - rect.left) / rect.width\n    const targetTime = pos * audioBuffer.duration\n    pauseOffset = targetTime\n\n    if (isPlaying) {\n      playBuffer(targetTime)\n    } else {\n      progress.style.width = (pos * 100) + '%'\n    }\n  }\n})\n</script>\n</body>\n</html>\n","css":".my-custom-box {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n  background: #fff;\n  border-radius: 20px;\n}\n.my-custom-box img {\n  width: 50px;\n  height: 50px;\n  border-radius: 50%;\n}","images":{"cover":""},"userFields":[{"key":"songTitle","label":"歌名","type":"text"}],"updatedAt":1786651031208}]